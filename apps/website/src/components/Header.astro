---
import Logo from "./Logo.astro";
const { pathname } = Astro.url;
const links = [
  { href: "/", label: "Home" },
  { href: "/docs", label: "Docs" },
  { href: "/download", label: "Download" },
  { href: "/about", label: "About" },
];
function isActive(href: string): boolean {
  if (href === "/") return pathname === "/" || pathname === "";
  return pathname.startsWith(href);
}
---

<header class="site-header">
  <div class="container nav">
    <a class="brand" href="/">
      <Logo size={28} />
      <span>OpenWebHMI</span>
    </a>
    <details class="nav-menu">
      <summary aria-label="Open navigation">
        <span class="sr-only">Menu</span>
        <span class="menu-icon" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
      </summary>
      <nav aria-label="Primary navigation">
        {links.map((link) => (
          <a class={isActive(link.href) ? "active" : ""} href={link.href}>
            {link.label}
          </a>
        ))}
        <a
          class="github"
          href="https://github.com/sergiogallegos/OpenWebHMI"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="OpenWebHMI on GitHub"
        >
          GitHub ↗
        </a>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: saturate(140%) blur(8px);
    position: sticky;
    top: 0;
    z-index: 10;
  }

  @media (prefers-color-scheme: dark) {
    .site-header {
      background: rgba(10, 14, 26, 0.85);
    }
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
    gap: 16px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--text);
    letter-spacing: -0.01em;
    flex: 0 0 auto;
  }

  .brand:hover {
    text-decoration: none;
  }

  .nav-menu {
    position: relative;
  }

  summary {
    display: none;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  nav a {
    padding: 8px 14px;
    border-radius: 6px;
    color: var(--text-muted);
    font-size: 0.95rem;
    font-weight: 500;
  }

  nav a:hover {
    color: var(--text);
    background: var(--surface);
    text-decoration: none;
  }

  nav a.active {
    color: var(--brand);
    background: var(--brand-soft);
  }

  nav a.github {
    margin-left: 8px;
    color: var(--text);
    border: 1px solid var(--border-strong);
  }

  @media (max-width: 720px) {
    .nav {
      min-height: 60px;
      height: auto;
      padding-top: 10px;
      padding-bottom: 10px;
    }

    .brand {
      gap: 8px;
      font-size: 1rem;
    }

    summary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 42px;
      height: 42px;
      border: 1px solid var(--border-strong);
      border-radius: var(--radius);
      background: var(--surface);
      color: var(--text);
      cursor: pointer;
      list-style: none;
    }

    summary::-webkit-details-marker {
      display: none;
    }

    summary:hover {
      background: var(--surface-alt);
    }

    .menu-icon {
      display: grid;
      gap: 4px;
      width: 18px;
    }

    .menu-icon span {
      display: block;
      height: 2px;
      border-radius: 999px;
      background: currentColor;
    }

    nav {
      position: absolute;
      top: calc(100% + 10px);
      right: 0;
      width: min(280px, calc(100vw - 32px));
      display: none;
      flex-direction: column;
      align-items: stretch;
      gap: 4px;
      padding: 8px;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background: var(--bg);
      box-shadow: var(--shadow-lg);
    }

    .nav-menu[open] nav {
      display: flex;
    }

    nav a {
      padding: 11px 12px;
      font-size: 1rem;
    }

    nav a.github {
      margin-left: 0;
      margin-top: 4px;
      text-align: center;
    }
  }
</style>
