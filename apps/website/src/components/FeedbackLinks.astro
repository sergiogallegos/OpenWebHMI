---
import Icon from "./Icon.astro";
interface Props { compact?: boolean; }
const { compact = false } = Astro.props;
---

<div class:list={["feedback-links", { compact }]}>
  <a class:list={["github-feedback", { "button primary": !compact }]} href="https://github.com/sergiogallegos/OpenWebHMI/issues" target="_blank" rel="noopener noreferrer"><Icon name="github" inverse={!compact} /> Share feedback on GitHub <span aria-hidden="true">↗</span></a>
  <div class="personal-links" aria-label="Follow the maintainer">
    <a href="https://x.com/SergioGallegosH" target="_blank" rel="noopener noreferrer"><Icon name="x" /> Sergio on X</a>
    <a href="https://sergiogallegos.net" target="_blank" rel="noopener noreferrer"><Icon name="globe" /> Personal website</a>
  </div>
</div>

<style>
  .feedback-links {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    margin-top: 24px;
  }

  a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .github-feedback {
    font-weight: 600;
  }

  .personal-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px 24px;
  }

  .personal-links a {
    color: var(--text-muted);
    font-size: 0.82rem;
  }

  .personal-links a:hover {
    color: var(--text);
  }

  .personal-links :global(.icon) {
    transform: scale(0.8);
  }

  .compact {
    align-items: flex-start;
    margin: 0;
    gap: 12px;
  }

  .compact .github-feedback {
    font-size: 0.88rem;
    color: var(--text);
  }

  .compact .personal-links {
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }
</style>
